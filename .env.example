# Copy to .env.local and fill in. Never commit .env.local.
# BUILD_PLAN.md §14: every variable is documented here, nothing is hardcoded.

# --- Database ---------------------------------------------------------------
# Neon Postgres. The pooled connection string, not the direct one.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth -------------------------------------------------------------------
# 32+ chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The deployed origin. http://localhost:3000 in development,
# https://aminsolahuddin.com in production.
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app. Callback URL must be:
#   {BETTER_AUTH_URL}/api/auth/callback/github
# Two OAuth apps are needed, one per origin, because GitHub matches the callback
# exactly:
#   http://localhost:3000/api/auth/callback/github
#   https://aminsolahuddin.com/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# The single GitHub login allowed into /admin. Every other account is rejected
# at signup and again on every request. Until this is set, /admin returns 404 to
# everyone, including Amin.
#
# This is ONE login, not a list, and it differs per environment:
#   .env.local (laptop)  ADMIN_GITHUB_LOGIN=iSolahTech
#   Vercel (production)  ADMIN_GITHUB_LOGIN=aminsolahuddin
#
# Consequence worth knowing: whichever account is set here is the only one that
# gets in. Being signed into the other GitHub account in the browser will fail
# the login with "This GitHub account is not permitted to sign in." That is the
# check working, not a bug. Case does not matter.
ADMIN_GITHUB_LOGIN=""

# --- Public -----------------------------------------------------------------
# Feeds canonical URLs, hreflang, OG tags and the sitemap. Falls back to the
# Vercel preview URL, then localhost.
# Production is https://aminsolahuddin.com — apex, no www, no trailing slash.
# Leave this as localhost in .env.local; set the real value in Vercel only.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Umami or Plausible. Cookieless, so no consent banner is required. §10.
NEXT_PUBLIC_ANALYTICS_URL=""

# --- Jobs (Phase 2) ---------------------------------------------------------
# Fine-grained PAT, read-only, public repos only. Unauthenticated requests hit
# the GitHub rate limit almost immediately. §7.
GITHUB_SYNC_TOKEN=""
# Shared secret the cron routes check before doing any work.
CRON_SECRET=""

# --- Media (Phase 1) --------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# --- Email (Phase 3) --------------------------------------------------------
# Unused until the newsletter ships. Double opt-in only. §10.
RESEND_API_KEY=""
